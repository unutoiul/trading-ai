# Data directory
# Add all these patterns to your .gitignore
# Data files anywhere in the project
**/data/
**/*.csv
**/*.parquet
**/*.feather
**/*.pickle
**/*.pkl

# Specific large data files
find_patterns/data/*.csv
find_patterns/data/BTC_USDT*.csv
find_patterns/data/DOGE_USDT*.csv

#/ Python cache files
__pycache__/
*.py[cod]
*$py.class

# Environment directories
venv/
.venv/
env/
.env

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db